{
  "name": "liltag",
  "version": "1.0.0",
  "description": "LilTag is a simple and flexible JavaScript tag management system designed for developers, allowing dynamic loading of scripts based on specific triggers.",
  "main": "dist/liltag.js",
  "module": "dist/liltag.js",
  "types": "dist/liltag.d.ts",
  "scripts": {
    "build": "npm run types && webpack --config webpack.config.js && npm run minify",
    "types": "tsc --emitDeclarationOnly",
    "minify": "terser dist/liltag.js -o dist/liltag.min.js --source-map \"url=liltag.min.js.map\"",
    "start": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deeravenger/liltag.git"
  },
  "keywords": [
    "tag",
    "management",
    "javascript",
    "dynamic",
    "loader",
    "developer"
  ],
  "author": "Dmitry Kuznetsov",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.0.0",
    "jsdom": "^24.0.0",
    "terser": "^5.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.0.0",
    "util": "^0.12.5",
    "vitest": "^2.0.0",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
